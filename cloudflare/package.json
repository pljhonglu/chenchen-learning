{
  "name": "chenchen-learning-api",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker + D1 progress sync for chenchen-learning",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create chenchen-learning-progress",
    "db:migrate:local": "wrangler d1 execute chenchen-learning-progress --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute chenchen-learning-progress --remote --file=./schema.sql",
    "whoami": "wrangler whoami"
  },
  "devDependencies": {
    "wrangler": "3.112.0"
  }
}
